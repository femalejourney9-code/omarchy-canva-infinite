#!/bin/bash
# omarchy:summary=Open the canvas editor, focusing it if already open
# omarchy:args=[doc-id]
# omarchy:examples=omarchy-canvas-open|omarchy-canvas-open roadmap
#
# Focuses an existing Canvas window when one is open, otherwise summons the
# panel through omarchy-shell. Mirrors omarchy-launch-or-focus: a single entry
# point that behaves like launching an app.

set -euo pipefail

DOC_ID="${1:-default}"

# Focus a live Canvas window if one exists.
address=$(hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.title | test("^Canvas – "; "i")) | .address' 2>/dev/null | head -n 1)

if [[ -n ${address:-} ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
  exit 0
fi

exec omarchy-shell shell summon io.github.hermes.canvas "$(printf '{"doc":"%s"}' "${DOC_ID//\"/}")"
